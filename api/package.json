{
  "name": "zhizhi-api",
  "version": "1.0.0",
  "description": "知之ZHIZHI API - Vercel Serverless Functions",
  "main": "index.js",
  "scripts": {
    "dev": "vercel dev",
    "dev:node": "ts-node server.ts",
    "doctor": "node scripts/doctor.js",
    "generate:ganzhi-calendar": "node scripts/generate-ganzhi-calendar.js",
    "generate:four-pillars-daily-index": "node scripts/generate-four-pillars-daily-index.js",
    "verify:ganzhi-calendar": "node scripts/verify-ganzhi-calendar.js",
    "verify:four-pillars-daily-index": "node scripts/verify-four-pillars-daily-index.js",
    "build": "tsc",
    "test:docs": "ts-node tests/docsIntegrity.test.ts && node scripts/verify-docs.js",
    "test:shensha": "ts-node tests/shenShaValidation.ts",
    "test:wuxing": "ts-node tests/weightedWuxing.test.ts",
    "test:bazi-basic-info": "ts-node tests/baziBasicInfo.test.ts",
    "test:mingli-ai-context": "ts-node tests/mingliAiContext.test.ts",
    "test:patterns": "ts-node tests/patternJudgement.test.ts",
    "test:ziping-facts": "ts-node tests/zipingStructureFacts.test.ts",
    "test:mingli-interactions": "ts-node tests/mingliInteractions.test.ts",
    "test:true-solar-time": "ts-node tests/trueSolarTimeService.test.ts",
    "test:history": "ts-node tests/historyService.test.ts",
    "test:invite": "ts-node tests/inviteCodeService.test.ts",
    "test:auth-infra": "ts-node tests/authInfrastructure.test.ts",
    "test:commerce": "ts-node tests/commerceService.test.ts",
    "test:daily-fortune": "ts-node tests/dailyFortuneAi.test.ts && ts-node tests/dailyFortuneBaziBoundary.test.ts && ts-node tests/dailyFortuneService.test.ts && ts-node tests/dailyFortuneRoute.test.ts",
    "eval:daily-fortune": "ts-node scripts/run-daily-fortune-eval.ts",
    "test:recommendations": "ts-node tests/recommendationAi.test.ts && ts-node tests/recommendationMigration.test.ts && ts-node tests/recommendationTimeWindows.test.ts && ts-node tests/recommendationService.test.ts && ts-node tests/recommendationRoute.test.ts && ts-node tests/recommendationUserContext.test.ts && ts-node tests/recommendationEval.test.ts",
    "deploy": "vercel --prod",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "vercel",
    "serverless",
    "supabase",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apple/app-store-server-library": "^3.0.0",
    "@supabase/supabase-js": "^2.39.3",
    "@vercel/node": "^3.0.12",
    "dotenv": "^16.3.1",
    "lunar-javascript": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vercel": "^33.0.1"
  }
}
