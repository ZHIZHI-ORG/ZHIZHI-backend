# Supabase 配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# 应用配置
NODE_ENV=development
API_SECRET_KEY=your-secret-key-for-jwt

# 注册邀请码门禁
# false：当前默认，允许无邀请码注册；true：恢复注册前强制邀请码
INVITE_CODE_REQUIRED=false

# 可选：AI 生成服务
# 不填时，fortune / insights 会回退到示例占位数据，便于前端本地调试
GEMINI_API_KEY=your-gemini-api-key-here

# 首页日运 V2：不使用旧 fortune / insights 的示例回退
# 开启生成时，GEMINI_API_KEY 与固定模型名均为必填
DAILY_FORTUNE_V2_GENERATION_ENABLED=true
DAILY_FORTUNE_AI_MODEL=gemini-model-name
# 可选，默认 90000；首页首次生成允许完整完成，允许 1-120000
DAILY_FORTUNE_AI_TIMEOUT_MS=90000
# 可选，数据库 single-flight 的全局并发上限，默认 20
DAILY_FORTUNE_MAX_ACTIVE_GENERATIONS=20

# 知识页个性化推荐 V1：生产开启前必须先执行数据库迁移 013、014
RECOMMENDATIONS_V1_ENABLED=false
# 可选；未设置时复用 DAILY_FORTUNE_AI_MODEL / DAILY_FORTUNE_AI_TIMEOUT_MS
RECOMMENDATION_AI_MODEL=
RECOMMENDATION_AI_TIMEOUT_MS=90000

# StoreKit 2 服务端交易校验；购买开关默认关闭，沙盒闭环通过后再开启
COMMERCE_PURCHASES_ENABLED=false
COMMERCE_SANDBOX_DELIVERY_ENABLED=false
# 仅填专用 Sandbox/App Review 测试账号的 users.id，逗号分隔
COMMERCE_SANDBOX_TEST_USER_IDS=
APPLE_IAP_BUNDLE_ID=com.ZHI9-25
APPLE_IAP_ENVIRONMENT=Production
APPLE_IAP_APP_APPLE_ID=6758699042
APPLE_IAP_ROOT_CERTIFICATES_BASE64=
APPLE_IAP_REQUIRE_SIGNED_VERIFICATION=true
