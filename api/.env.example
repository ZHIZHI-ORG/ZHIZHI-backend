# Supabase 配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# 应用配置
NODE_ENV=development
API_SECRET_KEY=your-secret-key-for-jwt

# 注册邀请码门禁
# false：当前默认，允许无邀请码注册；true：恢复注册前强制邀请码
INVITE_CODE_REQUIRED=false

# 可选：AI 生成服务
# 不填时，fortune / insights 会回退到示例占位数据，便于前端本地调试
GEMINI_API_KEY=your-gemini-api-key-here

# 可选：StoreKit 2 服务端交易校验
# 生产建议配置并设置 APPLE_IAP_REQUIRE_SIGNED_VERIFICATION=true
APPLE_IAP_BUNDLE_ID=com.yourcompany.zhizhi
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_IAP_APP_APPLE_ID=
APPLE_IAP_ROOT_CERTIFICATES_BASE64=
APPLE_IAP_REQUIRE_SIGNED_VERIFICATION=false
